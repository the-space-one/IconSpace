# ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Only the database URL is
# required — Redis and Resend are optional and degrade safely.
# ─────────────────────────────────────────────────────────────

# REQUIRED. Neon pooled connection string (host includes `-pooler`).
PRIMARY_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# OPTIONAL. Comma-separated mirror/failover Neon URLs. New signups and delivery
# status are copied asynchronously; a daily repair sweep backfills missed rows.
# If the primary fails its retries, the next URL takes the signup.
# Setup + rollout order (deploy safe sender BEFORE backfill): docs/database-mirroring.md
FALLBACK_DATABASE_URLS=

# OPTIONAL. Failover tuning.
DB_FAILOVER_COOLDOWN_MS=30000
DB_WRITE_RETRIES=2

# OPTIONAL. Redis for IP rate limiting (Upstash works). With this unset the
# limiter fails open and signups are simply not rate limited.
REDIS_URL=
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_REDIS_PREFIX=waitlist:ratelimit
# true = allow signups when Redis is down, false = reject them with a 503.
RATE_LIMIT_FAIL_OPEN=true

# OPTIONAL. Extra origins allowed to POST /api/waitlist in production.
# Same-origin always passes, so this is only for a separate frontend domain.
ALLOWED_ORIGINS=

# OPTIONAL. Public origin, no trailing slash. Only used to build an absolute URL
# for the logo in the confirmation email, since mail clients cannot resolve a
# relative path. On Vercel this falls back to the deployment URL automatically;
# locally it falls back to http://localhost:3000, so `npm run email` needs
# `next dev` running for the logo to load in the preview.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL. Confirmation email. With RESEND_API_KEY unset no email is sent and
# the signup is still saved (recorded on the row as `skipped_config`).
RESEND_API_KEY=
# Defaults to Resend's shared test sender, which needs no verified domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Used as the sender name AND the product name in the subject/body.
RESEND_FROM_NAME=Icon Space
RESEND_REPLY_TO_EMAIL=

# Automatic unsent-confirmation retries: daily at 08:00 UTC (13:30 India).
# Set a random secret of at least 16 characters in Vercel Production, then
# deploy. Never prefix this with NEXT_PUBLIC_. See docs/resend-confirmations.md.
# Also protects daily mirror repair at 07:00 UTC (12:30 India).
CRON_SECRET=
RESEND_DAILY_CAP=100
RESEND_SEND_HEADROOM=0
RESEND_MAX_CONSECUTIVE_FAILURES=5
# Optional distributed lock uses REDIS_URL above. Configure the same key for
# every cron/CLI targeting these databases. Without Redis: process-local only.
RESEND_LOCK_KEY=iconspace:resend-confirmations:lock

# OPTIONAL. Google Sheets backup of each new signup. With the URL unset nothing
# is mirrored and the signup is unaffected. Setup lives in
# scripts/waitlist-sheet.gs — deploy it as a web app and paste the /exec URL.
WAITLIST_SHEET_WEBHOOK_URL=
# Must match SECRET in the Apps Script. This is the only thing guarding the
# webhook, since the deployment has to be readable by "Anyone" to accept POSTs.
WAITLIST_SHEET_WEBHOOK_SECRET=
WAITLIST_SHEET_TIMEOUT_MS=15000
